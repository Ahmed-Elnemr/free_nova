{
	"info": {
		"_postman_id": "laravel-starter-code-api",
		"name": "Laravel Starter Code API",
		"description": "Complete API collection for Laravel Starter Code.\n\n**Base URLs**\n- Client: `{{base_url}}/api/v1/client`\n- Admin: `{{base_url}}/api/v1/admin`\n\n**Auth**\n- Client/User: OTP-based (Sanctum Bearer token)\n- Admin: Password login (Sanctum Bearer token)\n\n**Locale**\nSend `X-Locale: en` or `X-Locale: ar` (default: ar)\n\n**Seeded Admin**\n- Email: superadmin@example.com\n- Password: Test@123\n\n**OTP (local dev)**\nSet `USE_FIXED_OTP=true` in `.env` to use a fixed OTP code.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{ "key": "base_url", "value": "http://starter.test" },
		{ "key": "locale", "value": "en" },
		{ "key": "user_token", "value": "" },
		{ "key": "admin_token", "value": "" },
		{ "key": "blog_id", "value": "1" },
		{ "key": "user_id", "value": "1" },
		{ "key": "admin_id", "value": "1" },
		{ "key": "role_id", "value": "1" },
		{ "key": "comment_id", "value": "1" },
		{ "key": "notification_id", "value": "" },
		{ "key": "contact_message_id", "value": "1" },
		{ "key": "notification_group_id", "value": "1" }
	],
	"auth": {
		"type": "noauth"
	},
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"pm.request.headers.upsert({ key: 'Accept', value: 'application/json' });",
					"pm.request.headers.upsert({ key: 'X-Locale', value: pm.collectionVariables.get('locale') || 'en' });"
				]
			}
		}
	],
	"item": [
