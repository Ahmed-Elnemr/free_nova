							"request": {
								"method": "GET",
								"header": [],
								"url": {
									"raw": "{{base_url}}/api/v1/client/blogs?per_page=10&page=1",
									"host": ["{{base_url}}"],
									"path": ["api", "v1", "client", "blogs"],
									"query": [
										{ "key": "per_page", "value": "10" },
										{ "key": "page", "value": "1" },
