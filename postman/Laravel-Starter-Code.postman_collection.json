								"method": "POST",
								"header": [{ "key": "Content-Type", "value": "application/json" }],
								"body": {
									"mode": "raw",
									"raw": "{\n  \"name\": \"Abdelmaksoud\",\n  \"country_code\": \"+966\",\n  \"phone\": \"512345678\",\n  \"email\": \"abdelmaksoud@example.com\",\n  \"message_type\": \"inquiry\",\n  \"message\": \"Hello, I have a question about your services.\"\n}"
								},
								"url": "{{base_url}}/api/v1/client/contact-us",
								"description": "message_type: request | suggestion | inquiry | complaint | other"
							}
						},
