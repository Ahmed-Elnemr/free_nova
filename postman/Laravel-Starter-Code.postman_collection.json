				{
					"name": "Auth",
					"item": [
						{
							"name": "Register",
							"request": {
								"method": "POST",
								"header": [],
								"body": {
									"mode": "formdata",
									"formdata": [
										{ "key": "name", "value": "Abdelmaksoud", "type": "text" },
										{ "key": "country_code", "value": "+966", "type": "text" },
										{ "key": "phone", "value": "512345678", "type": "text" },
										{ "key": "email", "value": "user@example.com", "type": "text" },
										{ "key": "avatar", "type": "file", "src": [], "disabled": true }
									]
								},
								"url": "{{base_url}}/api/v1/client/auth/register",
								"description": "Returns OTP. Next step: Verify OTP with purpose `register`."
							}
						},
						{
							"name": "Login (Send OTP)",
							"request": {
								"method": "POST",
								"header": [{ "key": "Content-Type", "value": "application/json" }],
								"body": {
									"mode": "raw",
									"raw": "{\n  \"email\": \"user@example.com\"\n}"
								},
								"url": "{{base_url}}/api/v1/client/auth/login",
								"description": "Login with email OR phone+country_code."
							},
							"event": [
								{
									"listen": "test",
									"script": {
										"exec": [
											"const json = pm.response.json();",
											"if (json?.data?.otp) {",
											"    pm.collectionVariables.set('last_otp', json.data.otp);",
											"}"
										],
										"type": "text/javascript"
									}
								}
							]
						},
						{
							"name": "Login by Phone (Send OTP)",
							"request": {
								"method": "POST",
								"header": [{ "key": "Content-Type", "value": "application/json" }],
								"body": {
									"mode": "raw",
									"raw": "{\n  \"country_code\": \"+966\",\n  \"phone\": \"512345678\"\n}"
								},
								"url": "{{base_url}}/api/v1/client/auth/login"
							},
							"event": [
								{
									"listen": "test",
									"script": {
										"exec": [
											"const json = pm.response.json();",
											"if (json?.data?.otp) {",
											"    pm.collectionVariables.set('last_otp', json.data.otp);",
											"}"
										],
										"type": "text/javascript"
									}
								}
							]
						},
						{
							"name": "Verify OTP",
							"request": {
								"method": "POST",
								"header": [{ "key": "Content-Type", "value": "application/json" }],
								"body": {
									"mode": "raw",
									"raw": "{\n  \"email\": \"user@example.com\",\n  \"code\": \"123456\",\n  \"purpose\": \"login\",\n  \"fcm_token\": \"your-fcm-token\",\n  \"device_type\": \"android\"\n}"
								},
								"url": "{{base_url}}/api/v1/client/auth/verify-otp",
								"description": "purpose: login | register | change_phone\nfcm_token required for login & register."
							},
							"event": [
								{
									"listen": "test",
									"script": {
										"exec": [
											"const json = pm.response.json();",
											"if (json?.data?.token) {",
											"    pm.collectionVariables.set('user_token', json.data.token);",
											"}"
										],
										"type": "text/javascript"
									}
								}
							]
						},
						{
							"name": "Resend OTP",
							"request": {
								"method": "POST",
								"header": [{ "key": "Content-Type", "value": "application/json" }],
								"body": {
									"mode": "raw",
									"raw": "{\n  \"email\": \"user@example.com\",\n  \"purpose\": \"login\"\n}"
								},
								"url": "{{base_url}}/api/v1/client/auth/resend-otp"
							}
						},
						{
							"name": "Logout",
							"request": {
								"auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{user_token}}", "type": "string" }] },
								"method": "POST",
								"header": [{ "key": "Content-Type", "value": "application/json" }],
								"body": {
									"mode": "raw",
									"raw": "{\n  \"device_token\": \"\"\n}"
								},
								"url": "{{base_url}}/api/v1/client/auth/logout"
							}
						}
					]
				},
